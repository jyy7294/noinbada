# Optional one-time Trends MCP probe. The hourly job never uses it.
TRENDS_MCP_API_KEY=

# X uses the installed Google Chrome and a dedicated local profile; no X API key.
# Default: %LOCALAPPDATA%\TRZIP\chrome-profile
TRZIP_X_CHROME_PROFILE=
TRZIP_X_MINIMUM_ROWS=10
TRZIP_X_HEADED=0

# Optional company disclosure enrichment. Never commit a live key.
OPENDART_API_KEY=

# Laptop runtime defaults to %LOCALAPPDATA%\TRZIP and SQLite.
TRZIP_RUNTIME_ROOT=

# Comma-separated frontend origins. Use the deployed Vercel domain in production.
TRZIP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
