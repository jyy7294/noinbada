# Laptop runtime and the single SQLite ledger.
TRZIP_RUNTIME_ROOT=
TRZIP_DB_PATH=

# X is captured by the unpacked Chrome extension in the signed-in ChanHee
# profile. Python consumes only a complete, current-hour 1-30 inbox file.
TRZIP_X_INBOX=
TRZIP_X_MINIMUM_ROWS=30

# Google Trending Now Korea public web UI. No RSS or Trends MCP is used.
TRZIP_GOOGLE_CHROME_PROFILE=
TRZIP_GOOGLE_MINIMUM_ROWS=100
TRZIP_GOOGLE_HEADED=0

# Optional context/verification providers. They never affect the X+Google rank.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=

# Optional listed-company disclosure enrichment.
OPENDART_API_KEY=
