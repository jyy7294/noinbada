# Laptop runtime and the single SQLite ledger.
TRZIP_RUNTIME_ROOT=
TRZIP_DB_PATH=

# X is captured by Codex from the user's currently signed-in Chrome session.
# Python consumes only a complete, current-hour 1-30 inbox file.
TRZIP_X_INBOX=
TRZIP_X_MINIMUM_ROWS=30

# Google Trending Now Korea public web UI. No RSS or Trends MCP is used.
TRZIP_GOOGLE_CHROME_PROFILE=
TRZIP_GOOGLE_MINIMUM_ROWS=100
TRZIP_GOOGLE_HEADED=0

# Optional context/verification providers. They never affect the X+Google rank.
# Use one credential pair only.  The API Hub pair is for the migrated NAVER
# API Hub application; the standard pair is for the legacy Search API app.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
YOUTUBE_API_KEY=
# Accepted YouTube aliases also include YOUTUBE_DATA_API_KEY,
# GOOGLE_YOUTUBE_API_KEY, TRZIP_YOUTUBE_API_KEY, and KIWOOM_TRZIP_YOUTUBE_API_KEY.
INSTAGRAM_ACCESS_TOKEN=
TRZIP_PROVIDER_VERIFICATION_TERM_LIMIT=3
# Set to 1 only when running optional NAVER/YouTube context research.
# Single-source X or Google E2E keeps this disabled.
TRZIP_AUXILIARY_RESEARCH_ENABLED=0

# Optional evidence-bounded semantic review.  This is called only after a
# NAVER News item explicitly matches an observed X/Google expression.  It can
# approve/review/exclude semantic fit, but never changes source ranks or
# scores, creates URLs, or fills companies/keywords.
TRZIP_SEMANTIC_LLM_URL=
TRZIP_SEMANTIC_LLM_API_KEY=
TRZIP_SEMANTIC_LLM_MODEL=
TRZIP_SEMANTIC_LLM_LIMIT=12

# Optional listed-company disclosure enrichment.
OPENDART_API_KEY=
