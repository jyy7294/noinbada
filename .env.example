# Never commit a live key. Copy this file to .env and put the rotated key there.
TRENDS_MCP_API_KEY=

# Optional direct-X collector contract. Trends MCP is preferred for current X ranks.
X_BEARER_TOKEN=
X_KOREA_WOEID=
OPENDART_API_KEY=

# Render/production uses PostgreSQL. Keep empty for local SQLite tests.
DATABASE_URL=

# Comma-separated frontend origins. Use the deployed Vercel domain in production.
TRZIP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
