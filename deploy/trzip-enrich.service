[Unit]
Description=TR ZIP evidence and company enrichment
After=network-online.target
[Service]
LogNamespace=trzip
Type=oneshot
User=trzip
Group=trzip
WorkingDirectory=/srv/services/trzip/current
EnvironmentFile=/srv/services/trzip/runtime.env
ExecStart=/srv/services/trzip/venv/bin/python -m trzip.runtime enrich
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/services/trzip/state
MemoryMax=256M
CPUQuota=50%
TasksMax=32
UMask=0027
