{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jyy7294/noinbada/schemas/intelligence-v3.schema.json",
  "title": "TRZIP intelligence publication v3",
  "type": "object",
  "required": [
    "schema_version", "mode", "publication_id", "generated_at", "window",
    "sources", "ranking_availability", "ranking_data_readiness", "score_formula", "score_policy", "home_quality_gate",
    "ranking_default_period", "ranking_periods", "ranking_views", "ranking_top_level_alias",
    "company_identity_status",
    "unified_ranking", "trend_top10", "public_top10", "company_ready_trends",
    "ontology_enrichment_queue", "enrichment_work_queue", "provider_keyword_candidate_queue",
    "lanes", "verification_run", "collection_status"
  ],
  "properties": {
    "schema_version": {"const": "trzip-intelligence-v3"},
    "mode": {"const": "live"},
    "publication_id": {"type": "string", "pattern": "^pub-[0-9a-f]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "window": {
      "type": "object",
      "required": ["from", "to", "hours"],
      "properties": {
        "from": {"type": "string", "format": "date-time"},
        "to": {"type": "string", "format": "date-time"},
        "hours": {"type": "integer", "minimum": 1}
      }
    },
    "sources": {
      "type": "array",
      "prefixItems": [{"const": "x"}, {"const": "google_trends"}],
      "items": false
    },
    "ranking_availability": {"$ref": "#/$defs/rankingAvailability"},
    "ranking_data_readiness": {"type": "object"},
    "score_formula": {"type": "string", "minLength": 1},
    "score_policy": {"type": "object"},
    "ranking_default_period": {"const": "weekly"},
    "ranking_periods": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/rankingPeriod"}
    },
    "ranking_views": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daily", "weekly", "monthly"],
      "properties": {
        "daily": {"$ref": "#/$defs/rankingView"},
        "weekly": {"$ref": "#/$defs/rankingView"},
        "monthly": {"$ref": "#/$defs/rankingView"}
      }
    },
    "ranking_top_level_alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "unified_ranking", "trend_top10"],
      "properties": {
        "period": {"const": "weekly"},
        "unified_ranking": {"const": "weekly_period_aggregate"},
        "trend_top10": {"const": "weekly_period_top10"}
      }
    },
    "home_quality_gate": {
      "type": "object",
      "required": [
        "policy_version", "ranking_effect", "unified_ranking_preserved",
        "main_lane_total", "trend_top10_count", "company_count_affects_home",
        "minimum_published_companies", "home_eligible_total", "home_excluded_total",
        "exclusion_reasons", "context_resolved_total", "context_review_total",
        "context_review_reasons", "rule"
      ],
      "properties": {
        "policy_version": {"const": "home-trend-subset-v2"},
        "ranking_effect": {"const": "none"},
        "unified_ranking_preserved": {"const": true},
        "main_lane_total": {"type": "integer", "minimum": 0},
        "trend_top10_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "company_count_affects_home": {"const": false},
        "minimum_published_companies": {"const": 5},
        "home_eligible_total": {"type": "integer", "minimum": 0},
        "home_excluded_total": {"type": "integer", "minimum": 0},
        "exclusion_reasons": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "context_resolved_total": {"type": "integer", "minimum": 0},
        "context_review_total": {"type": "integer", "minimum": 0},
        "context_review_reasons": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "company_identity_status": {
      "type": "object",
      "required": ["provider", "requested", "fetched", "reused", "status_counts", "ranking_effect", "relationship_evidence"],
      "properties": {
        "provider": {"const": "opendart"},
        "requested": {"type": "integer", "minimum": 0},
        "fetched": {"type": "integer", "minimum": 0},
        "reused": {"type": "integer", "minimum": 0},
        "status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "ranking_effect": {"const": "none"},
        "relationship_evidence": {"const": false}
      }
    },
    "unified_ranking": {"type": "array", "items": {"$ref": "#/$defs/trend"}},
    "trend_top10": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/trend"}},
    "public_top10": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/trend"}},
    "company_ready_trends": {"type": "array", "items": {"$ref": "#/$defs/trend"}},
    "ontology_enrichment_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "event_key", "representative_term", "observed_terms", "evidence_backed_company_count", "minimum_required", "missing_company_paths", "status", "padding_forbidden", "affects_score"]
      }
    },
    "enrichment_work_queue": {
      "type": "object",
      "required": [
        "schema_version", "observed_at", "required_evidence_count", "counts",
        "tracked_observations", "pending_total", "pending_returned", "pending",
        "ranking_effect"
      ],
      "properties": {
        "schema_version": {"const": "trzip-enrichment-queue-v1"},
        "observed_at": {"type": "string", "format": "date-time"},
        "required_evidence_count": {"const": 5},
        "counts": {"type": "object"},
        "tracked_observations": {"type": "integer", "minimum": 0},
        "pending_total": {"type": "integer", "minimum": 0},
        "pending_returned": {"type": "integer", "minimum": 0, "maximum": 100},
        "pending": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "event_key", "task_kind", "representative_term", "last_seen_at",
              "latest_rank", "latest_lane", "priority", "current_count",
              "required_count", "missing_count", "observed_terms",
              "evidence_policy", "affects_score"
            ],
            "properties": {
              "task_kind": {"enum": ["related_keywords", "company_ontology"]},
              "required_count": {"const": 5},
              "affects_score": {"const": false}
            }
          }
        },
        "ranking_effect": {"const": "none"}
      }
    },
    "provider_keyword_candidate_queue": {
      "type": "object",
      "required": [
        "schema_version", "observed_at", "pending_total", "building_total", "pending_returned",
        "pending", "approval_policy", "ranking_effect", "source_commit"
      ],
      "properties": {
        "schema_version": {"const": "trzip-provider-keyword-candidates-v1"},
        "observed_at": {"type": "string", "format": "date-time"},
        "pending_total": {"type": "integer", "minimum": 0},
        "building_total": {"type": "integer", "minimum": 0},
        "pending_returned": {"type": "integer", "minimum": 0, "maximum": 100},
        "pending": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "event_key", "candidate_key", "display_text", "provider_count",
              "evidence_count", "status", "evidence", "publishable", "affects_score"
            ],
            "properties": {
              "status": {"const": "review_required"},
              "publishable": {"const": false},
              "affects_score": {"const": false}
            }
          }
        },
        "approval_policy": {"const": "human_or_reviewed_ontology_required_before_publication"},
        "ranking_effect": {"const": "none"},
        "source_commit": {"const": "jiyu/5e3031c-adapted"}
      }
    },
    "lanes": {
      "type": "object",
      "required": ["main", "issue", "review"],
      "properties": {
        "main": {"type": "array", "items": {"$ref": "#/$defs/trend"}},
        "issue": {"type": "array", "items": {"$ref": "#/$defs/trend"}},
        "review": {"type": "array", "items": {"$ref": "#/$defs/trend"}}
      }
    },
    "collection_status": {
      "type": "object",
      "required": ["observed_at", "observed_rows", "source_status", "errors", "partial"]
    },
    "verification_run": {
      "type": "object",
      "required": [
        "status", "requested_terms", "attempted_terms", "hourly_term_limit",
        "selection_policy", "candidate_count", "selection_scope",
        "providers", "ranking_effect", "affects_collection_partial", "blocks_publication", "error"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed", "skipped_no_candidates",
            "skipped_already_recorded_for_hour", "failed_non_blocking"
          ]
        },
        "requested_terms": {"type": "integer", "minimum": 0, "maximum": 3},
        "attempted_terms": {"type": "integer", "minimum": 0, "maximum": 3},
        "hourly_term_limit": {"type": "integer", "minimum": 0, "maximum": 3},
        "selection_policy": {"const": "never_verified_then_oldest_verified_then_current_rank"},
        "candidate_count": {"type": "integer", "minimum": 0},
        "selection_scope": {"const": "current_main_candidates_including_context_review"},
        "providers": {
          "type": "array",
          "prefixItems": [
            {"const": "naver"}, {"const": "youtube"}, {"const": "instagram"}
          ],
          "items": false
        },
        "ranking_effect": {"const": "none"},
        "affects_collection_partial": {"const": false},
        "blocks_publication": {"const": false},
        "error": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "rankingWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "hours", "score_history_hours", "lifecycle_baseline_days"],
      "properties": {
        "from": {"type": "string", "format": "date-time"},
        "to": {"type": "string", "format": "date-time"},
        "hours": {"enum": [24, 168, 720]},
        "score_history_hours": {"enum": [24, 168, 720]},
        "lifecycle_baseline_days": {"const": 60}
      }
    },
    "rankingPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "default", "window"],
      "properties": {
        "key": {"enum": ["daily", "weekly", "monthly"]},
        "label": {"type": "string", "minLength": 1},
        "default": {"type": "boolean"},
        "window": {"$ref": "#/$defs/rankingWindow"}
      }
    },
    "periodTrend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank", "main_rank", "event_key", "display_name", "topic",
        "broad_category", "category", "lane", "score", "score_components",
        "candidate_status", "is_current", "period_sources", "period_strength",
        "current_source_position", "momentum", "persistence", "freshness",
        "hours_since_last_seen", "previous_period_rank", "rank_change", "rank_change_status", "lifecycle",
        "lifecycle_reason", "first_seen_at", "last_seen_at", "latest_source_ranks",
        "rank_change_by_source", "source_badge", "data_confidence",
        "ranking_data_readiness", "company_card_status", "detail_event_key",
        "detail_status", "shared_detail_fields"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "main_rank": {"type": ["integer", "null"], "minimum": 1},
        "event_key": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "broad_category": {"enum": ["food", "content", "lifestyle", "sports", "culture", "consumer", "technology", "market", "issue", "other"]},
        "category": {"type": "string", "minLength": 1},
        "lane": {"enum": ["main", "issue", "review"]},
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "score_components": {"$ref": "#/$defs/period_score_components"},
        "candidate_status": {"enum": ["is_current", "period_observed"]},
        "is_current": {"type": "boolean"},
        "period_sources": {"type": "array", "uniqueItems": true, "items": {"enum": ["x", "google_trends"]}},
        "period_strength": {"type": "number", "minimum": 0, "maximum": 1},
        "current_source_position": {"type": "number", "minimum": 0, "maximum": 1},
        "momentum": {"type": "number", "minimum": 0, "maximum": 1},
        "persistence": {"type": "number", "minimum": 0, "maximum": 1},
        "freshness": {"type": "object"},
        "hours_since_last_seen": {"type": "number", "minimum": 0},
        "previous_period_rank": {"type": ["integer", "null"], "minimum": 1},
        "rank_change": {"type": ["integer", "null"]},
        "rank_change_status": {"enum": ["measured", "new_in_period", "unavailable_no_previous_period_coverage"]},
        "lifecycle": {"enum": ["new", "rising", "sustained", "rebounding", "cooling", "expired"]},
        "lifecycle_reason": {"type": "string", "minLength": 1},
        "first_seen_at": {"type": "string", "format": "date-time"},
        "last_seen_at": {"type": "string", "format": "date-time"},
        "latest_source_ranks": {"type": "object"},
        "rank_change_by_source": {"type": "object"},
        "source_badge": {"type": "string", "minLength": 1},
        "data_confidence": {"type": "object"},
        "ranking_data_readiness": {"type": "object"},
        "company_card_status": {"enum": ["ready", "enrichment_pending", "not_applicable"]},
        "detail_event_key": {"type": "string", "minLength": 1},
        "detail_status": {"enum": ["shared_full_detail", "period_summary_only"]},
        "shared_detail_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "keywords", "companies", "company_candidates", "company_resolution",
              "verification_layer", "news_context"
            ]
          }
        }
      }
    },
    "rankingView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key", "label", "default", "window", "formula_version",
        "data_readiness", "company_detail_policy", "company_count_affects_rank",
        "unified_ranking", "period_top10"
      ],
      "properties": {
        "key": {"enum": ["daily", "weekly", "monthly"]},
        "label": {"type": "string", "minLength": 1},
        "default": {"type": "boolean"},
        "window": {"$ref": "#/$defs/rankingWindow"},
        "formula_version": {"const": "period40_momentum20_persistence20_recency15_cross5_v1"},
        "data_readiness": {"type": "object"},
        "company_detail_policy": {"const": "shared_by_detail_event_key"},
        "company_count_affects_rank": {"const": false},
        "unified_ranking": {"type": "array", "items": {"$ref": "#/$defs/periodTrend"}},
        "period_top10": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/periodTrend"}}
      }
    },
    "rankingAvailability": {
      "type": "object",
      "required": [
        "status", "label", "is_combined_rank", "current_sources",
        "missing_sources", "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "unavailable", "provisional_single_source",
            "provisional_history", "mature_combined"
          ]
        },
        "label": {"type": "string", "minLength": 1},
        "is_combined_rank": {"type": "boolean"},
        "current_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["x", "google_trends"]}
        },
        "missing_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["x", "google_trends"]}
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "keyword": {
      "type": "object",
      "required": ["text", "source", "observed_hours", "status", "role", "role_status", "affects_score"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "source": {"type": "array", "items": {"enum": ["x", "google_trends", "reviewed_ontology"]}},
        "observed_hours": {"type": "integer", "minimum": 0},
        "status": {"enum": ["observed_ranked_term", "observed_related_query", "approved_ontology_term", "approved_ontology_related_term"]},
        "role": {"type": "string", "minLength": 1},
        "role_status": {"enum": ["deterministic_draft", "reviewed_evidence"]},
        "evidence_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
        "affects_score": {"const": false}
      }
    },
    "ontologyEdge": {
      "type": "object",
      "required": ["from", "to", "edge_type", "evidence_urls", "evidence_type", "as_of", "review_status"]
    },
    "company": {
      "type": "object",
      "required": [
        "company", "stock_code", "relationship_reason", "company_summary",
        "business_features", "relation_tier", "relation_display_type", "verification_status",
        "ontology_path", "ontology_complete", "evidence_sources", "official_identity"
      ],
      "properties": {
        "company": {"type": "string", "minLength": 1},
        "stock_code": {"type": "string", "minLength": 6},
        "relationship_reason": {"type": "string", "minLength": 1},
        "company_summary": {"type": "string", "minLength": 1},
        "business_features": {"type": "array", "items": {"type": "string"}},
        "relation_tier": {"enum": ["core", "value_chain", "adjacent"]},
        "relation_display_type": {"enum": ["직접 관계", "가치사슬", "산업 관찰"]},
        "verification_status": {"const": "ontology_evidence"},
        "ontology_complete": {"type": "boolean"},
        "ontology_path": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/ontologyEdge"}},
        "evidence_sources": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "official_identity": {"$ref": "#/$defs/officialIdentity"}
      }
    },
    "officialIdentity": {
      "type": "object",
      "required": [
        "status", "provider", "company", "stock_code", "legal_name", "english_name",
        "stock_name", "market_class", "homepage", "established_date", "retrieved_at",
        "ranking_effect", "relationship_evidence"
      ],
      "properties": {
        "status": {"enum": ["verified", "unavailable", "not_found", "error", "stock_code_mismatch"]},
        "provider": {"const": "opendart"},
        "company": {"type": "string", "minLength": 1},
        "stock_code": {"type": "string", "pattern": "^[0-9]{6}$"},
        "legal_name": {"type": ["string", "null"]},
        "english_name": {"type": ["string", "null"]},
        "stock_name": {"type": ["string", "null"]},
        "market_class": {"type": ["string", "null"]},
        "homepage": {"type": ["string", "null"]},
        "established_date": {"type": ["string", "null"]},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "ranking_effect": {"const": "none"},
        "relationship_evidence": {"const": false}
      }
    },
    "period_score_components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_strength_points", "momentum_points", "persistence_points",
        "recency_points", "cross_source_points", "total_points",
        "formula_version", "rounding_policy"
      ],
      "properties": {
        "period_strength_points": {"type": "number", "minimum": 0, "maximum": 40},
        "momentum_points": {"type": "number", "minimum": 0, "maximum": 20},
        "persistence_points": {"type": "number", "minimum": 0, "maximum": 20},
        "recency_points": {"type": "number", "minimum": 0, "maximum": 15},
        "cross_source_points": {"type": "number", "minimum": 0, "maximum": 5},
        "total_points": {"type": "number", "minimum": 0, "maximum": 100},
        "formula_version": {"const": "period40_momentum20_persistence20_recency15_cross5_v1"},
        "rounding_policy": {"const": "each_component_2dp_then_sum_2dp"}
      }
    },
    "trend": {
      "type": "object",
      "required": [
        "rank", "main_rank", "event_key", "display_name", "observed_representative_term",
        "display_name_policy", "raw_terms", "broad_category",
        "lane", "score", "score_components", "candidate_status", "is_current",
        "period_sources", "period_strength", "freshness", "hours_since_last_seen",
        "previous_period_rank", "rank_change", "rank_change_status", "latest_source_ranks",
        "current_source_position", "momentum", "persistence", "score_explanation",
        "source_metrics", "ranking_data_readiness", "lifecycle", "lifecycle_reason",
        "lifecycle_baseline", "rank_change_by_source", "first_seen_at", "last_seen_at",
        "data_confidence", "keywords", "companies", "company_candidates",
        "company_resolution", "verification_layer", "news_context",
        "home_context_status", "home_context_reason", "company_card_status", "company_card_reason",
        "ranking_availability_status"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "main_rank": {"type": ["integer", "null"], "minimum": 1},
        "event_key": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "observed_representative_term": {"type": "string", "minLength": 1},
        "display_name_policy": {
          "enum": ["observed_representative_term", "reviewed_stock_code_to_company_name"]
        },
        "raw_terms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "broad_category": {"enum": ["food", "content", "lifestyle", "sports", "culture", "consumer", "technology", "market", "issue", "other"]},
        "lane": {"enum": ["main", "issue", "review"]},
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "score_components": {"$ref": "#/$defs/period_score_components"},
        "candidate_status": {"enum": ["is_current", "period_observed"]},
        "is_current": {"type": "boolean"},
        "period_sources": {"type": "array", "uniqueItems": true, "items": {"enum": ["x", "google_trends"]}},
        "period_strength": {"type": "number", "minimum": 0, "maximum": 1},
        "freshness": {"type": "object"},
        "hours_since_last_seen": {"type": "number", "minimum": 0},
        "previous_period_rank": {"type": ["integer", "null"], "minimum": 1},
        "rank_change": {"type": ["integer", "null"]},
        "rank_change_status": {"enum": ["measured", "new_in_period", "unavailable_no_previous_period_coverage"]},
        "current_source_position": {"type": "number", "minimum": 0, "maximum": 1},
        "momentum": {"type": "number", "minimum": 0, "maximum": 1},
        "persistence": {"type": "number", "minimum": 0, "maximum": 1},
        "score_explanation": {"type": "object"},
        "source_metrics": {"type": "object"},
        "ranking_data_readiness": {"type": "object"},
        "lifecycle": {"enum": ["new", "rising", "sustained", "rebounding", "cooling", "expired"]},
        "lifecycle_reason": {"type": "string", "minLength": 1},
        "lifecycle_baseline": {"type": "object"},
        "rank_change_by_source": {"type": "object"},
        "first_seen_at": {"type": "string", "format": "date-time"},
        "last_seen_at": {"type": "string", "format": "date-time"},
        "latest_source_ranks": {"type": "object"},
        "data_confidence": {"type": "object"},
        "keywords": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/keyword"}},
        "companies": {
          "type": "array",
          "items": {"$ref": "#/$defs/company"},
          "oneOf": [{"maxItems": 0}, {"minItems": 5}]
        },
        "company_candidates": {"type": "array", "items": {"$ref": "#/$defs/company"}},
        "company_resolution": {"type": "object"},
        "verification_layer": {"type": "object"},
        "news_context": {"type": "object"},
        "home_context_status": {"enum": ["resolved", "review_required"]},
        "home_context_reason": {
          "enum": [
