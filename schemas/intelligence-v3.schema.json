{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jyy7294/noinbada/schemas/intelligence-v3.schema.json",
  "title": "TRZIP intelligence publication v3",
  "type": "object",
  "required": [
    "schema_version", "mode", "publishable", "publication_id", "generated_at", "window",
    "sources", "ranking_availability", "ranking_data_readiness", "score_formula", "score_policy", "home_quality_gate", "publication_readiness",
    "ranking_default_period", "ranking_periods", "ranking_views", "ranking_top_level_alias",
    "company_identity_status",
    "unified_ranking", "all_observed_ranking", "presentation_feed", "home_feed", "home_top10", "home_status", "rising_top10",
    "category_summary", "trend_top10", "public_top10", "company_ready_trends",
    "ontology_enrichment_queue", "enrichment_work_queue", "provider_keyword_candidate_queue",
    "lanes", "verification_run", "collection_status"
  ],
  "properties": {
    "schema_version": {"const": "trzip-intelligence-v3"},
    "mode": {"const": "live"},
    "publishable": {"type": "boolean"},
    "publication_id": {"type": "string", "pattern": "^pub-[0-9a-f]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "window": {
      "type": "object",
      "required": ["from", "to", "hours"],
      "properties": {
        "from": {"type": "string", "format": "date-time"},
        "to": {"type": "string", "format": "date-time"},
        "hours": {"type": "integer", "minimum": 1}
      }
    },
    "sources": {
      "type": "array",
      "prefixItems": [{"const": "x"}, {"const": "google_trends"}],
      "items": false
    },
    "ranking_availability": {"$ref": "#/$defs/rankingAvailability"},
    "ranking_data_readiness": {"type": "object"},
    "score_formula": {"type": "string", "minLength": 1},
    "score_policy": {"type": "object"},
    "ranking_default_period": {"const": "daily"},
    "ranking_periods": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/rankingPeriod"}
    },
    "ranking_views": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daily", "weekly", "monthly"],
      "properties": {
        "daily": {"$ref": "#/$defs/rankingView"},
        "weekly": {"$ref": "#/$defs/rankingView"},
        "monthly": {"$ref": "#/$defs/rankingView"}
      }
    },
    "ranking_top_level_alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "unified_ranking", "trend_top10"],
      "properties": {
        "period": {"const": "daily"},
        "unified_ranking": {"const": "daily_period_aggregate"},
        "trend_top10": {"const": "daily_home_top10"}
      }
    },
    "home_quality_gate": {
      "type": "object",
      "required": [
        "policy_version", "ranking_effect", "unified_ranking_preserved",
        "main_lane_total", "trend_top10_count", "company_count_affects_home",
        "minimum_published_companies", "home_eligible_total", "home_excluded_total",
        "exclusion_reasons", "context_resolved_total", "context_review_total",
        "context_review_reasons", "rule"
      ],
      "properties": {
        "policy_version": {"const": "home-trend-subset-v4"},
        "ranking_effect": {"const": "none"},
        "unified_ranking_preserved": {"const": true},
        "main_lane_total": {"type": "integer", "minimum": 0},
        "trend_top10_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "company_count_affects_home": {"const": false},
        "minimum_published_companies": {"const": 3},
        "home_eligible_total": {"type": "integer", "minimum": 0},
        "home_excluded_total": {"type": "integer", "minimum": 0},
        "exclusion_reasons": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "context_resolved_total": {"type": "integer", "minimum": 0},
        "context_review_total": {"type": "integer", "minimum": 0},
        "context_review_reasons": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "publication_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version", "ready_count", "published_count",
        "pending_count", "publication_ready", "home_status", "required_keyword_count",
        "minimum_company_count", "padding_forbidden", "ranking_effect", "rule"
      ],
      "properties": {
        "policy_version": {"const": "home-feed-contract-v1"},
        "ready_count": {"type": "integer", "minimum": 0},
        "published_count": {"type": "integer", "minimum": 0},
        "pending_count": {"type": "integer", "minimum": 0},
        "publication_ready": {"type": "boolean"},
        "home_status": {"enum": ["ready", "empty"]},
        "required_keyword_count": {"const": 5},
        "minimum_company_count": {"const": 10},
        "padding_forbidden": {"const": true},
        "ranking_effect": {"const": "none"},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "company_identity_status": {
      "type": "object",
      "required": ["provider", "requested", "fetched", "reused", "status_counts", "ranking_effect", "relationship_evidence"],
      "properties": {
        "provider": {"const": "opendart"},
        "requested": {"type": "integer", "minimum": 0},
        "fetched": {"type": "integer", "minimum": 0},
        "reused": {"type": "integer", "minimum": 0},
        "status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "ranking_effect": {"const": "none"},
        "relationship_evidence": {"const": false}
      }
    },
    "unified_ranking": {"type": "array", "items": {"$ref": "#/$defs/trend"}},
    "all_observed_ranking": {"type": "array", "items": {"$ref": "#/$defs/trend"}},
    "presentation_feed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "frontend_default", "items", "transition"],
      "properties": {
        "schema_version": {
          "enum": ["trzip-presentation-feed-v2", "trzip-presentation-feed-v3"]
        },
        "status": {"const": "ready"},
        "frontend_default": {"const": true},
        "logo_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "avatar_size_px", "minimum_raster_dimension_px", "vector_assets_allowed", "low_resolution_fallback", "runtime_probe_for_generic_favicons"],
          "properties": {
            "version": {"const": "avatar-sharpness-v1"},
            "avatar_size_px": {"const": 44},
            "minimum_raster_dimension_px": {"const": 64},
            "vector_assets_allowed": {"const": true},
            "low_resolution_fallback": {"const": "initials"},
            "runtime_probe_for_generic_favicons": {"const": true}
          }
        },
        "items": {
          "type": "array", "minItems": 10, "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "presentation_position", "display_name", "event_key", "category", "category_label",
              "sources", "data_mode", "trend_definition", "why_now", "keywords", "companies",
              "keyword_status", "company_card_status", "ranking_effect"
            ],
            "properties": {
              "presentation_position": {"type": "integer", "minimum": 1, "maximum": 10},
              "rank_movement": {
                "type": "object",
                "additionalProperties": false,
                "required": ["current_rank", "previous_rank", "delta", "status", "label", "basis"],
                "properties": {
                  "current_rank": {"type": "integer", "minimum": 1, "maximum": 10},
                  "previous_rank": {"type": ["integer", "null"], "minimum": 1, "maximum": 10},
                  "delta": {"type": ["integer", "null"], "minimum": -9, "maximum": 9},
                  "status": {"enum": ["new", "unchanged", "up", "down"]},
                  "label": {"type": "string", "pattern": "^(NEW|유지|▲[1-9]|▼[1-9])$"},
                  "basis": {"const": "previous_published_presentation_feed"}
                }
              },
              "display_name": {"type": "string", "minLength": 1},
              "event_key": {"type": "string", "minLength": 1},
              "category": {"enum": ["food", "content", "sports", "lifestyle", "culture", "consumer", "technology", "market"]},
              "category_label": {"type": "string", "minLength": 1},
              "sources": {"type": "array", "minItems": 1, "items": {"enum": ["x", "google_trends"]}},
              "data_mode": {"const": "observed_reference"},
              "trend_definition": {"type": "string", "minLength": 1},
              "why_now": {"type": "string", "minLength": 1},
              "keywords": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object"}},
              "companies": {"type": "array", "items": {"type": "object"}},
              "keyword_status": {"const": "ready"},
              "company_card_status": {"enum": ["ready", "enrichment_pending"]},
              "ranking_effect": {"const": "none"}
            }
          }
        },
        "transition": {"type": "object"}
      }
    },
    "home_feed": {"$ref": "#/$defs/homeFeed"},
    "home_top10": {"type": "array", "items": {"type": "object"}},
    "home_status": {"enum": ["ready", "empty"]},
    "rising_top10": {"type": "array", "items": {"type": "object"}},
    "category_summary": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["category", "category_label", "observed_count", "home_candidate_count", "home_top10_count", "rising_top10_count"]
      }
    },
    "trend_top10": {"type": "array", "items": {"type": "object"}},
    "public_top10": {"type": "array", "items": {"type": "object"}},
    "company_ready_trends": {"type": "array", "items": {"$ref": "#/$defs/trend"}},
    "youtube_content_discovery": {
      "type": "object",
      "required": ["schema_version", "observed_at", "status", "region", "chart", "row_count", "trend_count", "ranking", "top10", "video_chart", "category_charts", "ranking_effect", "affects_x_google_rank", "documentation", "limitations"],
      "properties": {
        "schema_version": {"const": "trzip-youtube-content-ranking-v1"},
        "status": {"enum": ["observed", "unavailable", "failed"]},
        "region": {"const": "KR"},
        "chart": {"const": "mostPopular"},
        "row_count": {"type": "integer", "minimum": 0, "maximum": 50},
        "trend_count": {"type": "integer", "minimum": 0, "maximum": 50},
        "ranking_effect": {"const": "separate_content_lane"},
        "affects_x_google_rank": {"const": false},
        "ranking": {"type": "array", "maxItems": 50},
        "top10": {"type": "array", "maxItems": 10},
        "video_chart": {"type": "array", "maxItems": 50},
        "category_charts": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["category_id", "category_label", "status", "row_count", "error_code", "ranking"],
            "properties": {
              "category_id": {"enum": ["1", "10", "20", "24"]},
              "status": {"enum": ["observed", "unavailable", "failed"]},
              "row_count": {"type": "integer", "minimum": 0, "maximum": 50},
              "ranking": {"type": "array", "maxItems": 50}
            }
          }
        }
      }
    },
    "youtube_content_ranking": {"type": "array", "maxItems": 50},
    "youtube_content_top10": {"type": "array", "maxItems": 10},
    "ontology_enrichment_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "event_key", "representative_term", "observed_terms", "evidence_backed_company_count", "minimum_required", "missing_company_paths", "status", "padding_forbidden", "affects_score"]
      }
    },
    "enrichment_work_queue": {
      "type": "object",
      "required": [
        "schema_version", "observed_at", "required_evidence_count", "counts",
        "tracked_observations", "pending_total", "pending_returned", "pending",
        "ranking_effect"
      ],
      "properties": {
        "schema_version": {"const": "trzip-enrichment-queue-v1"},
        "observed_at": {"type": "string", "format": "date-time"},
        "required_evidence_count": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trend_context", "related_keywords", "company_ontology"],
          "properties": {
            "trend_context": {"const": 1},
            "related_keywords": {"const": 5},
            "company_ontology": {"const": 10}
          }
        },
        "counts": {"type": "object"},
        "tracked_observations": {"type": "integer", "minimum": 0},
        "pending_total": {"type": "integer", "minimum": 0},
        "pending_returned": {"type": "integer", "minimum": 0, "maximum": 100},
        "pending": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "event_key", "task_kind", "representative_term", "last_seen_at",
              "latest_rank", "latest_lane", "priority", "current_count",
              "required_count", "missing_count", "observed_terms",
              "evidence_policy", "affects_score"
            ],
            "properties": {
              "task_kind": {"enum": ["trend_context", "related_keywords", "company_ontology"]},
              "required_count": {"enum": [1, 5, 10]},
              "affects_score": {"const": false}
            }
          }
        },
        "ranking_effect": {"const": "none"}
      }
    },
    "provider_keyword_candidate_queue": {
      "type": "object",
      "required": [
        "schema_version", "observed_at", "pending_total", "building_total", "pending_returned",
        "pending", "approval_policy", "ranking_effect", "source_commit"
      ],
      "properties": {
        "schema_version": {"const": "trzip-provider-keyword-candidates-v1"},
        "observed_at": {"type": "string", "format": "date-time"},
        "pending_total": {"type": "integer", "minimum": 0},
        "building_total": {"type": "integer", "minimum": 0},
        "pending_returned": {"type": "integer", "minimum": 0, "maximum": 100},
        "pending": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "event_key", "candidate_key", "display_text", "provider_count",
              "evidence_count", "status", "evidence", "publishable", "affects_score"
            ],
            "properties": {
              "status": {"const": "review_required"},
              "publishable": {"const": false},
              "affects_score": {"const": false}
            }
          }
        },
        "approval_policy": {"const": "human_or_reviewed_ontology_required_before_publication"},
        "ranking_effect": {"const": "none"},
        "source_commit": {"const": "jiyu/5e3031c-adapted"}
      }
    },
    "lanes": {
      "type": "object",
      "required": ["main", "issue", "review"],
      "properties": {
        "main": {"type": "array", "items": {"$ref": "#/$defs/trend"}},
        "issue": {"type": "array", "items": {"$ref": "#/$defs/trend"}},
        "review": {"type": "array", "items": {"$ref": "#/$defs/trend"}}
      }
    },
    "collection_status": {
      "type": "object",
      "required": ["observed_at", "observed_rows", "source_status", "errors", "partial"]
    },
    "verification_run": {
      "type": "object",
      "required": [
        "status", "requested_terms", "attempted_terms", "hourly_term_limit",
        "selection_policy", "candidate_count", "selection_scope",
        "providers", "ranking_effect", "home_ranking_effect", "affects_collection_partial", "blocks_publication", "error"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed", "skipped_no_candidates",
            "skipped_already_recorded_for_hour", "failed_non_blocking",
            "disabled_by_runtime_policy"
          ]
        },
        "requested_terms": {"type": "integer", "minimum": 0, "maximum": 20},
        "attempted_terms": {"type": "integer", "minimum": 0, "maximum": 20},
        "hourly_term_limit": {"type": "integer", "minimum": 0, "maximum": 20},
        "selection_policy": {"const": "never_verified_then_oldest_verified_then_current_rank"},
        "candidate_count": {"type": "integer", "minimum": 0},
        "selection_scope": {"const": "current_non_issue_candidates_including_review_lane"},
        "providers": {
          "type": "array",
          "prefixItems": [
            {"const": "naver"}, {"const": "youtube"}, {"const": "instagram"}
          ],
          "items": false
        },
        "ranking_effect": {"const": "none"},
        "home_ranking_effect": {"enum": ["none_auxiliary_research_disabled", "none_news_context_only"]},
        "affects_collection_partial": {"const": false},
        "blocks_publication": {"const": false},
        "error": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "homeFeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "groups", "selection_policy", "legacy_alias_status"],
      "properties": {
        "status": {"enum": ["ready", "empty"]},
        "selection_policy": {"const": "home-feed-selection-v2-x-google-only"},
        "legacy_alias_status": {"const": "deprecated_flattened_home_feed"},
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "definition", "trends"],
            "properties": {
              "key": {"enum": ["spreading", "sustained", "emerging"]},
              "label": {"type": "string", "minLength": 1},
              "definition": {"type": "string", "minLength": 1},
              "trends": {"type": "array", "minItems": 1, "items": {"type": "object"}}
            }
          }
        }
      }
    },
    "attentionChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1w", "1m", "3m"],
      "properties": {
        "1w": {"$ref": "#/$defs/changeMetric"},
        "1m": {"$ref": "#/$defs/changeMetric"},
        "3m": {"$ref": "#/$defs/changeMetric"}
      }
    },
    "changeMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "percent", "basis"],
      "properties": {
        "status": {"enum": ["measured", "unavailable"]},
        "percent": {"type": ["number", "null"]},
        "basis": {
          "enum": [
            "previous_equal_period_score",
            "insufficient_90_day_observed_history"
          ]
        }
      }
    },
    "rankingWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "hours", "score_history_hours", "lifecycle_baseline_days"],
      "properties": {
        "from": {"type": "string", "format": "date-time"},
        "to": {"type": "string", "format": "date-time"},
        "hours": {"enum": [24, 168, 720]},
        "score_history_hours": {"enum": [24, 168, 720]},
        "lifecycle_baseline_days": {"const": 60}
      }
    },
    "rankingPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "default", "window"],
      "properties": {
        "key": {"enum": ["daily", "weekly", "monthly"]},
        "label": {"type": "string", "minLength": 1},
        "default": {"type": "boolean"},
        "window": {"$ref": "#/$defs/rankingWindow"}
      }
    },
    "periodTrend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank", "observed_rank", "main_rank", "home_rank", "publication_rank", "rising_rank",
        "event_key", "display_name", "topic", "broad_category", "category",
        "category_label", "trend_definition", "lane", "home_eligible", "score", "score_components",
        "candidate_status", "is_current", "period_sources", "period_strength",
        "current_source_position", "momentum", "momentum_delta", "persistence", "freshness",
        "hours_since_last_seen", "previous_period_rank", "rank_change", "rank_change_status", "lifecycle",
        "lifecycle_reason", "first_seen_at", "last_seen_at", "latest_source_ranks",
        "rank_change_by_source", "source_rank_change", "source_badge", "data_confidence",
        "ranking_data_readiness", "company_card_status", "company_status", "keyword_status",
        "frontend_readiness_status", "frontend_readiness_missing", "frontend_keyword_count", "frontend_company_count", "detail_event_key",
        "detail_status", "shared_detail_fields"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "observed_rank": {"type": "integer", "minimum": 1},
        "main_rank": {"type": ["integer", "null"], "minimum": 1},
        "home_rank": {"type": ["integer", "null"], "minimum": 1},
        "home_platform_score": {"type": "number", "minimum": 0, "maximum": 100},
        "home_platform_components": {"type": "object"},
        "home_platform_weights": {"type": "object"},
        "naver_home_rank_status": {"enum": ["context_only_not_comparable_rank_signal"]},
        "youtube_home_rank_status": {"enum": ["disabled_by_home_feed_policy"]},
        "naver_candidate_signal": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "youtube_candidate_signal": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "home_platform_coverage": {"type": "object"},
        "home_source_policy": {"const": "home-feed-selection-v2-x-google-only"},
        "home_rank_input_sources": {"type": "array", "uniqueItems": true, "items": {"enum": ["x", "google_trends", "naver", "youtube"]}},
        "canonical_observed_rank_preserved": {"const": true},
        "home_mix_bucket": {"enum": ["emerging", "established", "recent_context"]},
        "home_mix_policy": {"const": "multisource_velocity_mix_v4"},
        "publication_rank": {"type": ["integer", "null"], "minimum": 1},
        "rising_rank": {"type": ["integer", "null"], "minimum": 1},
        "event_key": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "broad_category": {"enum": ["food", "content", "lifestyle", "sports", "culture", "consumer", "technology", "market", "issue", "other"]},
        "category": {"type": "string", "minLength": 1},
        "category_label": {"type": "string", "minLength": 1},
        "trend_definition": {"type": "string", "minLength": 1},
        "lane": {"enum": ["main", "issue", "review"]},
        "home_eligible": {"type": "boolean"},
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "score_components": {"$ref": "#/$defs/period_score_components"},
        "candidate_status": {"enum": ["is_current", "period_observed"]},
        "is_current": {"type": "boolean"},
        "period_sources": {"type": "array", "uniqueItems": true, "items": {"enum": ["x", "google_trends"]}},
        "period_strength": {"type": "number", "minimum": 0, "maximum": 1},
        "current_source_position": {"type": "number", "minimum": 0, "maximum": 1},
        "momentum": {"type": "number", "minimum": 0, "maximum": 1},
        "momentum_delta": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
        "persistence": {"type": "number", "minimum": 0, "maximum": 1},
        "freshness": {"type": "object"},
        "hours_since_last_seen": {"type": "number", "minimum": 0},
        "previous_period_rank": {"type": ["integer", "null"], "minimum": 1},
        "rank_change": {"type": ["integer", "null"]},
        "rank_change_status": {"enum": ["measured", "new_in_period", "unavailable_no_previous_period_coverage"]},
        "lifecycle": {"enum": ["new", "rising", "sustained", "rebounding", "cooling", "expired", "insufficient_data"]},
        "lifecycle_reason": {"type": "string", "minLength": 1},
        "first_seen_at": {"type": "string", "format": "date-time"},
        "last_seen_at": {"type": "string", "format": "date-time"},
        "latest_source_ranks": {"type": "object"},
        "rank_change_by_source": {"type": "object"},
        "source_rank_change": {"type": "object"},
        "source_badge": {"type": "string", "minLength": 1},
        "data_confidence": {"type": "object"},
        "ranking_data_readiness": {"type": "object"},
        "verification_layer": {"type": "object"},
        "attention_change": {"$ref": "#/$defs/attentionChange"},
