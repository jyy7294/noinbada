{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jyy7294/noinbada/schemas/status-v1.schema.json",
  "title": "TRZIP runtime status v1",
  "type": "object",
  "required": [
    "schema_version", "publication_id", "generated_at", "observed_at", "mode",
    "publishable", "partial", "source_status", "errors", "recorded_runs", "measurement_status", "processing_cycle", "final_release_approval"
  ],
  "properties": {
    "schema_version": {"const": "trzip-runtime-status-v1"},
    "publication_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "mode": {"const": "live"},
    "publishable": {"type": "boolean"},
    "processing_cycle": {"type": "object"},
    "final_release_approval": {
      "type": "object",
      "required": ["policy_version", "required", "status", "verified", "approved_event_keys", "approved_count", "review_sha256", "ranking_effect"],
      "properties": {
        "policy_version": {"const": "trzip-final-publication-approval-v1"},
        "required": {"type": "boolean"},
        "verified": {"type": "boolean"},
        "approved_event_keys": {"type": "array", "maxItems": 10, "uniqueItems": true},
        "approved_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ranking_effect": {"const": "none"}
      }
    },
    "partial": {"type": "boolean"},
    "source_status": {
      "type": "object",
      "required": ["x", "google_trends"]
    },
    "errors": {"type": "object"},
    "recorded_runs": {"type": "integer", "minimum": 0},
    "measurement_status": {"type": "string"}
  }
}
