{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jyy7294/noinbada/schemas/metadata-v3.schema.json",
  "title": "TRZIP publication metadata v3",
  "type": "object",
  "required": [
    "schema_version", "publication_id", "generated_at", "observed_at", "mode", "publishable",
    "storage", "collection", "coverage", "collection_health", "company_identity_data"
  ],
  "properties": {
    "schema_version": {"const": "trzip-live-data-v3"},
    "publication_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "mode": {"const": "live"},
    "publishable": {"type": "boolean"},
    "storage": {"const": "local-sqlite-published-to-live-data"},
    "collection": {"type": "object"},
    "coverage": {"type": "object"},
    "collection_health": {
      "type": "object",
      "required": [
        "current_publication_scheduled_at", "current_publication_attempt_type",
        "current_publication_status", "current_publication_success",
        "current_publication_source_success", "current_schedule_initial_attempt_success",
        "latest_scheduled_at", "latest_scheduled_attempt_success",
        "latest_scheduled_attempt_source_success", "recovered_from_scheduled_failure"
      ],
      "properties": {
        "current_publication_scheduled_at": {"type": "string", "format": "date-time"},
        "current_publication_attempt_type": {"enum": ["scheduled", "recovery"]},
        "current_publication_status": {
          "enum": [
            "scheduled_complete", "scheduled_partial", "recovered_complete",
            "republished_complete", "recovery_partial"
          ]
        },
        "current_publication_success": {"type": "boolean"},
        "current_publication_source_success": {"$ref": "#/$defs/sourceSuccess"},
        "current_schedule_initial_attempt_success": {"type": "boolean"},
        "latest_scheduled_at": {"type": "string", "format": "date-time"},
        "latest_scheduled_attempt_success": {"type": "boolean"},
        "latest_scheduled_attempt_source_success": {"$ref": "#/$defs/sourceSuccess"},
        "recovered_from_scheduled_failure": {"type": "boolean"}
      }
    },
    "company_identity_data": {
      "type": "object",
      "required": ["provider", "requested", "fetched", "reused", "ranking_effect", "relationship_evidence"],
      "properties": {
        "provider": {"const": "opendart"},
        "requested": {"type": "integer", "minimum": 0},
        "fetched": {"type": "integer", "minimum": 0},
        "reused": {"type": "integer", "minimum": 0},
        "ranking_effect": {"const": "none"},
        "relationship_evidence": {"const": false}
      }
    }
  },
  "$defs": {
    "sourceSuccess": {
      "type": "object",
      "required": ["x", "google_trends"],
      "properties": {
        "x": {"type": "boolean"},
        "google_trends": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
